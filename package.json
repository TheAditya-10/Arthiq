{
  "name": "arthiq",
  "private": true,
  "version": "0.1.0",
  "description": "Personal finance intelligence and reconciliation system",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "db:migrate": "pnpm --filter @arthiq/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @arthiq/database db:migrate:deploy",
    "db:seed": "pnpm --filter @arthiq/database db:seed",
    "db:generate": "pnpm --filter @arthiq/database db:generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "expo-modules-autolinking": "2.0.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
