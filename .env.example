# ============================================================================
# Arthiq — Environment Variables
# Copy this file to .env (root, for Docker Compose) and to each app's own
# .env.local / .env as needed. NEVER commit a real .env file.
# See docs/DEPLOYMENT.md and docs/SECURITY.md for full context.
# ============================================================================

# ---------------------------------------------------------------------------
# Database (packages/database, apps/api)
# ---------------------------------------------------------------------------
# Pooled connection string — used by the running application.
DATABASE_URL="postgresql://arthiq:arthiq@localhost:5432/arthiq?schema=public"
# Unpooled/direct connection string — used only for running migrations.
# In local dev (Docker Compose) this is the same as DATABASE_URL. In
# production with a pooled provider (e.g. Neon), this points at the direct
# (non-pooled) endpoint instead.
DIRECT_URL="postgresql://arthiq:arthiq@localhost:5432/arthiq?schema=public"
# Separate database used only by `pnpm test`'s API integration tests —
# never point this at a database with real data; tests truncate tables
# between runs. See docs/TESTING_STRATEGY.md.
TEST_DATABASE_URL="postgresql://arthiq:arthiq@localhost:5432/arthiq_test?schema=public"

# ---------------------------------------------------------------------------
# Auth (apps/api) — see docs/ADR/003-authentication.md
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Only the access token is a JWT — refresh tokens are opaque random bytes,
# stored server-side as a SHA-256 hash (see apps/api/src/lib/refreshToken.ts),
# so there is no separate JWT_REFRESH_SECRET to set.
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ---------------------------------------------------------------------------
# API server (apps/api)
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV="development"
# Comma-separated list of origins allowed to call the API (web app URL(s)).
CORS_ALLOWED_ORIGINS="http://localhost:3000"
# Pino log level — optional, defaults to "info". One of: fatal, error, warn, info, debug, trace.
# LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---------------------------------------------------------------------------
# AI Classification (optional — packages/classification, apps/api)
# See docs/CLASSIFICATION_ENGINE.md. The system is fully functional with
# this unset; AIClassifier is only invoked as a low-confidence fallback.
# When set, apps/api/src/lib/anthropicAIClassifier.ts calls Anthropic's real
# public Messages API (https://docs.anthropic.com/en/api/messages) with only
# the normalized merchant/amount/direction and the user's own category
# names — never raw notification text or other transactions.
# ---------------------------------------------------------------------------
# AI_PROVIDER_API_KEY=""
# AI_CONFIDENCE_THRESHOLD="0.6"

# ---------------------------------------------------------------------------
# Mobile (apps/mobile) — build-time config, see docs/MOBILE_ARCHITECTURE.md
# ---------------------------------------------------------------------------
# EXPO_PUBLIC_API_URL="http://10.0.2.2:4000"   # 10.0.2.2 = host machine from Android emulator

# ---------------------------------------------------------------------------
# Debug flags — NEVER enable in production (see docs/SECURITY.md)
# ---------------------------------------------------------------------------
# DEBUG_STORE_RAW_NOTIFICATIONS="false"
